# =============================================================================
# Environment variables for PharmaChain Blockchain Microservice
# =============================================================================

# Public JWKS endpoint of pharma-core for validating Bearer JWTs
PHARMA_CORE_JWKS_URL=http://pharma-core:4000/.well-known/jwks.json

# Port for Spring Boot gateway REST endpoints
SERVER_PORT=8080

# (Optional overrides for Fabric Gateway parameters)
# CHANNEL_NAME=mychannel
# MSP_ID=Org1MSP
# PEER_ENDPOINT=peer0.org1.example.com:7051
# PEER_OVERRIDE_AUTH=peer0.org1.example.com
