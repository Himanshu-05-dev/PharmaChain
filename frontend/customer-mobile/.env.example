EXPO_PUBLIC_CONSUMER_API_URL=http://localhost:3003/api/consumer
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Web Client ID — required for all platforms (Expo Go uses it via the auth proxy)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native Client IDs — needed only for standalone/production EAS builds
# Android: Google Cloud Console → Credentials → Android → package: in.pharmachain.mediacare
# iOS: Google Cloud Console → Credentials → iOS → bundle: in.pharmachain.mediacare
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
